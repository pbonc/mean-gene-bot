# Google Sheets Configuration for Playlist Sync
GOOGLE_SERVICE_ACCOUNT_JSON=C:\keys\mean-gene-bot-service-account.json
PLAYLIST_SPREADSHEET_ID=your-spreadsheet-id-from-step-2

# Example:
# GOOGLE_SERVICE_ACCOUNT_JSON=C:\keys\mean-gene-service-account.json  
# PLAYLIST_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms

# Stream RPG v2 presence windows
RPG_V2_ACTIVE_MINUTES=20
RPG_V2_WALKOFF_MINUTES=45

# World of Tanks Modern Armor / WoTWoM
# Create an application at https://developers.wargaming.net/
WOT_APPLICATION_ID=your-wargaming-application-id
# Use either the numeric account ID or an exact Xbox/PlayStation player name.
WOT_ACCOUNT_ID=
WOT_PLAYER_NAME=
# Browser callback used for private console-service authorization.
WOT_AUTH_REDIRECT_URI=http://localhost:8080/api/wotwom/auth/callback
# How often the bot checks for a newly played tank (minimum 5 minutes).
WOT_INVENTORY_REFRESH_SECONDS=900
STREAMSTART_OWNER_ID=

# Moonbase Alpha / DECTalk-compatible TTS
TTS_ENABLED=true
# Tested Perfect Paul / DECtalk 4.61 executable.
TTS_DECTALK_EXECUTABLE=C:\dev\perfect-paul\build\us\release\say.exe
# Automatically pass -pre "[:phoneme on]" before the untouched viewer message.
TTS_DECTALK_PHONEME_MODE=true
# This DECtalk 4.61 build hangs with -w; keep direct audio mode selected.
TTS_DECTALK_WAVE_MODE=false
# Optional argument template. Keep {text} as one argument; {voice} receives the default voice.
TTS_DECTALK_ARGS={text}
TTS_DEFAULT_VOICE=paul
TTS_MAX_INPUT_LENGTH=500
# Synthesis applies only if experimental WAV mode is enabled.
TTS_MAX_SYNTHESIS_SECONDS=20
TTS_MAX_PLAYBACK_SECONDS=60
TTS_GLOBAL_COOLDOWN_SECONDS=5
TTS_USER_COOLDOWN_SECONDS=30
TTS_MAX_QUEUE_DEPTH=5
TTS_ONE_QUEUED_PER_USER=true
TTS_MODS_BYPASS_COOLDOWNS=true
TTS_TOKENS_PERSIST=true

# Hermes Agent AI bridge. Keep Hermes bound to loopback and reach it through
# an SSH tunnel; never commit the bearer key used by both services.
HERMES_AI_ENABLED=false
HERMES_API_URL=http://127.0.0.1:8642
HERMES_LOCAL_TIMEZONE=America/Chicago
HERMES_API_KEY=replace-with-the-hermes-api-server-key
HERMES_TIMEOUT_SECONDS=900
HERMES_POLL_SECONDS=1
HERMES_ACK_DELAY_SECONDS=4
HERMES_USER_COOLDOWN_SECONDS=120
HERMES_GLOBAL_COOLDOWN_SECONDS=15
HERMES_MAX_PENDING=3
HERMES_MAX_PROMPT_CHARACTERS=1000
HERMES_MAX_CHAT_CHARACTERS=480
HERMES_RESEARCH_SYNTHESIS_ENABLED=false
HERMES_RESEARCH_SYNTHESIS_URL=http://127.0.0.1:11435
HERMES_RESEARCH_SYNTHESIS_MODEL=qwen3.5:9b
HERMES_RESEARCH_SYNTHESIS_TIMEOUT_SECONDS=30
HERMES_RESEARCH_SYNTHESIS_MAX_ANSWER_CHARACTERS=440
LORE_DB_PATH=data/lore.db
LORE_CAPTURE_ENABLED=false
LORE_CAPTURE_TRIGGER_MESSAGES=12
LORE_CAPTURE_COOLDOWN_SECONDS=90
LORE_CAPTURE_BUFFER_MESSAGES=40
LORE_CAPTURE_INPUT_MESSAGES=24
LORE_CAPTURE_INPUT_CHARACTERS=6000
LORE_CAPTURE_MAX_ITEMS=4
# Optional comma-separated Twitch usernames excluded from lore capture.
# Named bot accounts must be explicit, for example: Nightbot,Streamlabs
LORE_IGNORE_USERS=

# Private conversational Discord operator surface. Authorization fails closed
# unless every ID is configured and the author ID is explicitly allowlisted.
DISCORD_OPERATOR_ENABLED=false
DISCORD_TOKEN=
DISCORD_OPERATOR_GUILD_ID=
DISCORD_OPERATOR_CHANNEL_ID=
DISCORD_OPERATOR_USER_IDS=
DISCORD_OPERATOR_PENDING_TTL_SECONDS=300

# Optional sanitized Twitch-to-Hermes flight recorder. Discord telemetry uses
# the existing MGB Discord client/control channel when available; the webhook
# is an optional output-only fallback and must never be committed.
HERMES_DEBUG_ENABLED=false
HERMES_DEBUG_LOG_FILE=logs/hermes_debug.jsonl
HERMES_DEBUG_DISCORD_ENABLED=false
HERMES_DEBUG_DISCORD_WEBHOOK_URL=
HERMES_DEBUG_MAX_EVIDENCE_CHARS=1200
