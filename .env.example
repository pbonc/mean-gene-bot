# Google Sheets Configuration for Playlist Sync
GOOGLE_SERVICE_ACCOUNT_JSON=C:\keys\mean-gene-bot-service-account.json
PLAYLIST_SPREADSHEET_ID=your-spreadsheet-id-from-step-2

# Example:
# GOOGLE_SERVICE_ACCOUNT_JSON=C:\keys\mean-gene-service-account.json  
# PLAYLIST_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms

# Stream RPG v2 presence windows
RPG_V2_ACTIVE_MINUTES=20
RPG_V2_WALKOFF_MINUTES=45

# World of Tanks Modern Armor / WoTWoM
# Create an application at https://developers.wargaming.net/
WOT_APPLICATION_ID=your-wargaming-application-id
# Use either the numeric account ID or an exact Xbox/PlayStation player name.
WOT_ACCOUNT_ID=
WOT_PLAYER_NAME=
# Browser callback used for private console-service authorization.
WOT_AUTH_REDIRECT_URI=http://localhost:8080/api/wotwom/auth/callback
# How often the bot checks for a newly played tank (minimum 5 minutes).
WOT_INVENTORY_REFRESH_SECONDS=900
STREAMSTART_OWNER_ID=
