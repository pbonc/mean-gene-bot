# Twitch Bot Configuration
# Get these from https://dev.twitch.tv/console/apps
TWITCH_OAUTH_TOKEN=oauth:your_oauth_token_here
TWITCH_CLIENT_ID=your_client_id_here
TWITCH_CLIENT_SECRET=your_client_secret_here
TWITCH_BOT_ID=your_bot_user_id_here
TWITCH_CHANNELS=meangeneokc

# Discord Configuration (optional)
DISCORD_TOKEN=your_discord_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Optional API Keys
OPENAI_API_KEY=your_openai_api_key_here
WEATHER_API_KEY=your_weather_api_key_here
STREAMLABS_ACCESS_TOKEN=your_streamlabs_access_token_here
STREAMLABS_REFRESH_TOKEN=your_streamlabs_refresh_token_here
STREAMLABS_CLIENT_ID=your_streamlabs_client_id_here
STREAMLABS_CLIENT_SECRET=your_streamlabs_client_secret_here

# Google Sheets Integration (for playlist sync)
# Get service account JSON from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_JSON=C:\keys\mean-gene-bot-service-account.json
# Get spreadsheet ID from Google Sheet URL
PLAYLIST_SPREADSHEET_ID=your_google_sheet_id_here

# SFX Google Sheets Sync (existing feature)
SFX_SPREADSHEET_ID=your_sfx_spreadsheet_id_here
SFX_SHEET_NAME=sfx

# Stream RPG v2 presence windows
RPG_V2_ACTIVE_MINUTES=20
RPG_V2_WALKOFF_MINUTES=45
